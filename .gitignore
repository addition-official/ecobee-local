# ---------------------------------------------------------------------------
# CREDENTIALS — never commit these.
# Pairing files contain long-term HomeKit keys for your thermostats. Anyone
# with them can control your devices on your network. They live in a per-user
# folder by default, but if you ever point --folder at the repo or copy a
# pair file in, these rules keep them out of git. They match by NAME only
# (git can't look inside files): a pairing saved under another name, e.g.
# upstairs.json, is NOT covered. Use pair*.json names or one of the folders
# below inside a repo.
# ---------------------------------------------------------------------------
pair.json
pair*.json
*.pairing.json
ecobee-local/
pairings/
creds/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Editor / OS cruft
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
